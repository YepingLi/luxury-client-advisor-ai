# Gemini Developer API key from Google AI Studio.
# Keep this field blank here; fill it only in the ignored local .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# No Cloud project/location or ADC configuration is needed for this API.
LLM_MAX_ATTEMPTS=1
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1200
# Optional sampling parameter; omit when unsupported by the selected model.
# LLM_TEMPERATURE=0.6
# Explicit ceiling required for a live batch; includes retries and repairs.
# LLM_MAX_TOTAL_CALLS=75
MAX_INPUT_BYTES=131072
RUNS_DIR=runs
